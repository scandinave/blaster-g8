# Sound Blaster G8 - Fix ALSA defaults on card detection
# Matches on the sound subsystem (not raw USB), so the ALSA card is already registered.
# ATTRS walks up to the USB parent to match vendor/product ID.
#
# The script waits a few seconds before writing, so that it does not knock the
# card out of Direct Mode (see soundblaster-g8-alsa-fix.sh). That wait is why
# it has to run OUTSIDE the udev event: systemd-udevd kills whatever is left in
# the event's cgroup once the event completes, and a plain `sh -c '... &'` is
# still in that cgroup - the detached script was killed mid-sleep and the fix
# silently never applied. systemd-run puts it in its own transient unit.
#
# No --unit=: a fixed name collides when the card re-enumerates while a
# previous run is still sleeping. --collect reaps the unit if it fails.
SUBSYSTEM=="sound", ACTION=="add", DEVPATH=="*/controlC*", \
  ATTRS{idVendor}=="041e", ATTRS{idProduct}=="329b", \
  TEST=="/usr/bin/systemd-run", \
  RUN+="/usr/bin/systemd-run --no-block --collect --description='Sound Blaster G8 ALSA fix' /usr/local/bin/soundblaster-g8-alsa-fix.sh"

# Fallback for systems without systemd-run. Best effort: on systemd the child
# may be killed before the delay elapses, which is exactly the bug above - but
# such systems take the branch overhead. The GUI applies the same fix at
# startup (soundblaster_g8/alsa_fix.py), which covers the gap.
SUBSYSTEM=="sound", ACTION=="add", DEVPATH=="*/controlC*", \
  ATTRS{idVendor}=="041e", ATTRS{idProduct}=="329b", \
  TEST!="/usr/bin/systemd-run", \
  RUN+="/bin/sh -c '/usr/local/bin/soundblaster-g8-alsa-fix.sh &'"
