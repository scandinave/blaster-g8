# Règles udev pour la Creative Sound Blaster G8 (VID 041e / PID 329b)
#
# Installation :
#   sudo cp udev/99-soundblaster-g8.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Sous Linux, hidapi communique avec la carte via /dev/hidrawX : c'est donc
# ce noeud (et non seulement le device USB) qui doit être accessible.
# TAG+="uaccess" délègue les droits à l'utilisateur de la session locale,
# ce qui est plus sûr qu'un MODE="0666" global.

# Interface HID de contrôle (usage page 0xFF01) et interface Consumer
KERNEL=="hidraw*", ATTRS{idVendor}=="041e", ATTRS{idProduct}=="329b", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Device USB parent (utile pour les accès libusb / diagnostics lsusb -v)
SUBSYSTEM=="usb", ATTR{idVendor}=="041e", ATTR{idProduct}=="329b", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"
