# udev rules for the Creative Sound Blaster G8 (VID 041e / PID 329b)
#
# Installation:
#   sudo cp udev/99-soundblaster-g8.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# The two rules below cover the two usable hidapi backends:
#   * hidraw  -> direct access to /dev/hidrawX  (1st rule)
#   * libusb  -> access to the parent USB device (2nd rule)
# See soundblaster_g8/hidbackend.py for backend selection.
#
# Notes on permissions:
#   * TAG+="uaccess" is enough for normal use: systemd-logind then grants
#     access to the current *local session*'s user, with no group or global
#     MODE="0666" needed. This is the mechanism to prefer.
#   * GROUP="plugdev" is simply **ignored** on distributions that don't have
#     that group (Fedora, Arch, openSUSE...): udev logs an "unknown group"
#     warning and the rule still applies. Kept for Debian/Ubuntu, where it
#     also allows remote sessions.
#   * MODE="0660" with neither uaccess nor a matching group = root-only access.

# 1) hidraw nodes: control HID interface (usage page 0xFF01) and the
#    Consumer interface. This is what the hidraw backend opens.
KERNEL=="hidraw*", ATTRS{idVendor}=="041e", ATTRS{idProduct}=="329b", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"

# 2) Parent USB device. **Mandatory for the libusb backend**: it doesn't
#    use /dev/hidrawX but opens the device via usbfs
#    (/dev/bus/usb/BBB/DDD) and must detach the usbhid kernel driver from
#    interface 4 before it can issue SET_REPORT. Without this rule, opening
#    fails with LIBUSB_ERROR_ACCESS.
#    Also useful for 'lsusb -v' diagnostics without sudo.
SUBSYSTEM=="usb", ATTR{idVendor}=="041e", ATTR{idProduct}=="329b", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"
